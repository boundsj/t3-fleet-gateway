{
  "name": "t3-fleet-gateway",
  "version": "0.2.1",
  "private": true,
  "description": "Let hosted AI agents hand coding work to your own T3 Code servers over MCP, with OAuth and a durable job ledger.",
  "license": "MIT",
  "author": "Jesse Bounds",
  "type": "module",
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "bin": {
    "t3-fleet-gateway": "bin/t3-fleet-gateway.js"
  },
  "scripts": {
    "start": "node bin/t3-fleet-gateway.js serve",
    "test": "node --test --test-timeout=30000 --test-reporter=spec \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run privacy:check",
    "privacy:check": "node scripts/privacy-check.ts",
    "e2e:live": "node scripts/e2e-live.ts",
    "compat:check": "node scripts/check-t3-compatibility.ts",
    "webhooks:smoke": "node scripts/webhooks-smoke.ts",
    "dashboard:demo": "node scripts/dashboard-demo.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2"
  }
}
